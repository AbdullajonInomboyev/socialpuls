# Social Puls muhit sozlamalari. Nusxa oling: cp .env.example .env
# Bu faylga haqiqiy parol yoki token yozmang.

DEBUG=False
SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=puls.namdu.uz
CSRF_TRUSTED_ORIGINS=https://puls.namdu.uz
SITE_URL=https://puls.namdu.uz

# PostgreSQL (lokalda bo'sh qoldirilsa SQLite ishlatiladi)
DATABASE_URL=postgres://socialpuls:PAROL@127.0.0.1:5432/socialpuls

# Fayllar
PRIVATE_MEDIA_ROOT=/var/lib/socialpuls/private_media
USE_X_ACCEL_REDIRECT=True
UPLOAD_MAX_MB=10
LOG_DIR=/var/log/socialpuls

# HTTPS (Nginx orqasida)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000

# HEMIS: live (haqiqiy) yoki mock (faqat DEBUG=True, test talabalar)
HEMIS_MODE=live
HEMIS_STUDENT_API_URL=https://student.namdu.uz/rest/v1/
HEMIS_DATA_API_URL=https://student.namdu.uz/rest/v1/
HEMIS_API_TOKEN=
HEMIS_TIMEOUT=15

# Email (parolni tiklash va bildirishnomalar)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Social Puls <noreply@namdu.uz>

# Telegram bot (@BotFather). Webhook: https://puls.namdu.uz/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>/
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=     # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Kesh (bir nechta gunicorn worker uchun Redis yoki fayl kesh tavsiya etiladi)
CACHE_URL=filecache:///var/tmp/socialpuls_cache
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
